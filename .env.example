#copiar este archivo a .env y completar los valores reales
#el .env real no se sube a git

#puerto donde corre el servidor
PORT=4000

#conexion a mongodb atlas: la cadena se obtiene creando un cluster en mongodb.com/atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<basededatos>

#acceso al panel de administrador (/admin): entra la dueña con su cuenta de firebase.
#ADMIN_EMAIL indica cual es esa cuenta (si no se define, se usa la de la dueña por defecto)
ADMIN_EMAIL=

#clave para firmar los tokens de sesion de los usuarios que comentan
#usar una frase larga y aleatoria, igual que las anteriores: configurar en vercel
JWT_SECRET=cambia-esta-clave-secreta

#credenciales de la cuenta de servicio de firebase (firebase admin)
#se usan para validar los usuarios que crean cuenta desde el sitio
#se obtienen en la consola de firebase: configuracion del proyecto > cuentas de servicio > generar clave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=